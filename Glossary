<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Optics of Thought — A Glossary</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #04050d;
  --surface: #080b18;
  --border: #1a2040;
  --blue-dim: #1e3a5f;
  --blue-mid: #2d6a9f;
  --blue-bright: #5bb3f0;
  --white-soft: #cde4f7;
  --white-glow: #e8f4ff;
  --text: #b8d4ee;
  --muted: #4a6580;
  --accent-physics: #5bb3f0;
  --accent-psych: #a78bfa;
  --accent-poetic: #f0c85b;
  --accent-practice: #5bf0c0;
  --font-display: 'DM Serif Display', Georgia, serif;
  --font-mono: 'Space Mono', 'Courier New', monospace;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-mono);
  overflow-x: hidden;
  min-height: 100vh;
}

/* Star field */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    radial-gradient(1px 1px at 10% 15%, rgba(255,255,255,0.6) 0%, transparent 100%),
    radial-gradient(1px 1px at 25% 60%, rgba(255,255,255,0.4) 0%, transparent 100%),
    radial-gradient(1px 1px at 40% 30%, rgba(255,255,255,0.5) 0%, transparent 100%),
    radial-gradient(1px 1px at 55% 80%, rgba(255,255,255,0.3) 0%, transparent 100%),
    radial-gradient(1px 1px at 70% 20%, rgba(255,255,255,0.6) 0%, transparent 100%),
    radial-gradient(1px 1px at 80% 55%, rgba(255,255,255,0.4) 0%, transparent 100%),
    radial-gradient(1px 1px at 90% 40%, rgba(255,255,255,0.5) 0%, transparent 100%),
    radial-gradient(1px 1px at 15% 85%, rgba(255,255,255,0.3) 0%, transparent 100%),
    radial-gradient(1px 1px at 60% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
    radial-gradient(1px 1px at 35% 45%, rgba(255,255,255,0.2) 0%, transparent 100%),
    radial-gradient(1px 1px at 88% 72%, rgba(255,255,255,0.4) 0%, transparent 100%),
    radial-gradient(1px 1px at 5% 50%, rgba(255,255,255,0.3) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 48% 68%, rgba(200,230,255,0.5) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 73% 90%, rgba(200,230,255,0.4) 0%, transparent 100%),
    radial-gradient(2px 2px at 92% 8%, rgba(220,240,255,0.6) 0%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

/* Nebula glow */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 40% at 50% 0%, rgba(30,58,95,0.4) 0%, transparent 70%),
    radial-gradient(ellipse 40% 60% at 0% 50%, rgba(45,106,159,0.12) 0%, transparent 70%),
    radial-gradient(ellipse 40% 60% at 100% 50%, rgba(91,179,240,0.08) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* Header */
header {
  position: relative;
  z-index: 1;
  padding: 5rem 2rem 3rem;
  max-width: 780px;
  margin: 0 auto;
  text-align: center;
  opacity: 0;
  animation: fadeUp 1s ease forwards 0.3s;
}

.site-tag {
  font-size: 0.6rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--blue-bright);
  margin-bottom: 2rem;
  display: block;
}

h1 {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 6vw, 4rem);
  color: var(--white-glow);
  line-height: 1.1;
  margin-bottom: 0.5rem;
  text-shadow: 0 0 60px rgba(91,179,240,0.3);
}

h1 em {
  font-style: italic;
  color: var(--blue-bright);
}

.header-sub {
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.12em;
  margin-top: 1.5rem;
  line-height: 1.8;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

/* Layer legend */
.legend {
  position: relative;
  z-index: 1;
  max-width: 780px;
  margin: 0 auto 3rem;
  padding: 0 2rem;
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
  justify-content: center;
  opacity: 0;
  animation: fadeUp 1s ease forwards 0.6s;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.58rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
}

.legend-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

/* Filter nav */
.filter-nav {
  position: relative;
  z-index: 1;
  max-width: 780px;
  margin: 0 auto 3rem;
  padding: 0 2rem;
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
  opacity: 0;
  animation: fadeUp 1s ease forwards 0.75s;
}

.filter-btn {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  border: 1px solid var(--border);
  background: transparent;
  padding: 0.4em 1em;
  cursor: pointer;
  transition: all 0.2s;
}

.filter-btn:hover, .filter-btn.active {
  color: var(--blue-bright);
  border-color: var(--blue-bright);
  background: rgba(91,179,240,0.07);
}

/* Glossary grid */
.glossary {
  position: relative;
  z-index: 1;
  max-width: 780px;
  margin: 0 auto;
  padding: 0 2rem 6rem;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* Term card */
.term-card {
  background: rgba(8,11,24,0.85);
  border: 1px solid var(--border);
  border-left: 2px solid var(--blue-dim);
  overflow: hidden;
  transition: border-color 0.3s;
  opacity: 0;
  animation: fadeUp 0.6s ease forwards;
}

.term-card:hover {
  border-color: var(--blue-mid);
  border-left-color: var(--blue-bright);
}

.term-card.expanded {
  border-left-color: var(--blue-bright);
}

/* Card header */
.term-header {
  display: flex;
  align-items: center;
  padding: 1.4rem 1.8rem;
  cursor: pointer;
  gap: 1.5rem;
  transition: background 0.2s;
}

.term-header:hover { background: rgba(91,179,240,0.04); }

/* SVG animation container */
.term-icon {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  position: relative;
}

.term-icon svg {
  width: 100%;
  height: 100%;
}

.term-name {
  font-family: var(--font-display);
  font-size: 1.4rem;
  color: var(--white-glow);
  flex: 1;
  line-height: 1;
}

.term-function {
  font-size: 0.58rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  text-align: right;
}

.term-chevron {
  font-size: 0.7rem;
  color: var(--muted);
  transition: transform 0.3s ease;
  flex-shrink: 0;
}

.term-card.expanded .term-chevron { transform: rotate(180deg); }

/* Layers */
.term-layers {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.5s cubic-bezier(0.4,0,0.2,1);
}

.term-card.expanded .term-layers { max-height: 600px; }

.layers-inner {
  padding: 0 1.8rem 1.6rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: var(--border);
  border-top: 1px solid var(--border);
  margin-top: 0;
}

@media (max-width: 540px) {
  .layers-inner { grid-template-columns: 1fr; }
}

.layer {
  background: var(--bg);
  padding: 1.2rem 1.4rem;
  cursor: pointer;
  transition: background 0.2s;
  position: relative;
}

.layer:hover { background: rgba(91,179,240,0.03); }

.layer-label {
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 0.6rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.layer-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  flex-shrink: 0;
}

.layer-text {
  font-size: 0.8rem;
  line-height: 1.7;
  color: #8aaccc;
  font-family: var(--font-mono);
  font-weight: 400;
}

.layer.physics .layer-label { color: var(--accent-physics); }
.layer.psychological .layer-label { color: var(--accent-psych); }
.layer.poetic .layer-label { color: var(--accent-poetic); font-style: italic; }
.layer.practice .layer-label { color: var(--accent-practice); }

.layer.physics .layer-dot { background: var(--accent-physics); box-shadow: 0 0 6px var(--accent-physics); }
.layer.psychological .layer-dot { background: var(--accent-psych); box-shadow: 0 0 6px var(--accent-psych); }
.layer.poetic .layer-dot { background: var(--accent-poetic); box-shadow: 0 0 6px var(--accent-poetic); }
.layer.practice .layer-dot { background: var(--accent-practice); box-shadow: 0 0 6px var(--accent-practice); }

.layer.poetic .layer-text {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 0.9rem;
  color: rgba(240,200,91,0.8);
}

/* Progress dots when exploring sequentially */
.explore-bar {
  display: flex;
  gap: 0.4rem;
  padding: 0.8rem 1.8rem;
  border-top: 1px solid var(--border);
  align-items: center;
  background: rgba(8,11,24,0.5);
}

.explore-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  border: 1px solid var(--muted);
  transition: all 0.3s;
}

.explore-dot.lit { border-color: var(--blue-bright); background: var(--blue-bright); box-shadow: 0 0 8px var(--blue-bright); }

.explore-label {
  font-size: 0.55rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  margin-left: auto;
}

footer {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 2rem;
  font-size: 0.58rem;
  letter-spacing: 0.15em;
  color: var(--muted);
  border-top: 1px solid var(--border);
  text-transform: uppercase;
}

footer a {
  color: var(--blue-bright);
  text-decoration: none;
}

footer a:hover { text-decoration: underline; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

/* SVG animations */
@keyframes beamPulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

@keyframes rayRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes waveMove {
  from { transform: translateX(0); }
  to { transform: translateX(-8px); }
}

@keyframes scatter {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.3); }
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.anim-beam { animation: beamPulse 2.5s ease-in-out infinite; }
.anim-rotate { transform-origin: 26px 26px; animation: rayRotate 8s linear infinite; }
.anim-wave { animation: waveMove 1.5s ease-in-out infinite alternate; }
.anim-scatter { animation: scatter 2s ease-in-out infinite; }
.anim-blink { animation: blink 3s ease-in-out infinite; }
</style>
</head>
