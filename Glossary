  'self-assessment': terms.map((t, i) => t.tag === 'self-assessment' ? i : -1).filter(i => i >= 0),
  'perspective': terms.map((t, i) => t.tag === 'perspective' ? i : -1).filter(i => i >= 0),
  'conflict': terms.map((t, i) => t.tag === 'conflict' ? i : -1).filter(i => i >= 0),
  'attention': terms.map((t, i) => t.tag === 'attention' ? i : -1).filter(i => i >= 0),
  'shadow': terms.map((t, i) => t.tag === 'shadow' ? i : -1).filter(i => i >= 0),
  'alignment': terms.map((t, i) => t.tag === 'alignment' ? i : -1).filter(i => i >= 0),
};

function buildCards() {
  const glossary = document.getElementById('glossary');
  terms.forEach((term, i) => {
    const card = document.createElement('div');
    card.className = 'term-card';
    card.dataset.tag = term.tag;
    card.style.animationDelay = `${0.9 + i * 0.04}s`;
    card.innerHTML = `
      <div class="term-header" onclick="toggleCard(this.parentElement)">
        <div class="term-icon">${term.icon}</div>
        <div class="term-name">${term.name}</div>
        <div class="term-function">${term.function}</div>
        <div class="term-chevron">▾</div>
      </div>
      <div class="term-layers">
        <div class="layers-inner">
          <div class="layer physics">
            <div class="layer-label"><div class="layer-dot"></div>Physics</div>
            <div class="layer-text">${term.physics}</div>
          </div>
          <div class="layer psychological">
            <div class="layer-label"><div class="layer-dot"></div>Psychological</div>
            <div class="layer-text">${term.psychological}</div>
          </div>
          <div class="layer poetic">
            <div class="layer-label"><div class="layer-dot"></div>Poetic</div>
            <div class="layer-text">${term.poetic}</div>
          </div>
          <div class="layer practice">
            <div class="layer-label"><div class="layer-dot"></div>Practice</div>
            <div class="layer-text">${term.practice}</div>
          </div>
        </div>
        <div class="explore-bar">
          <div class="explore-dot lit" title="Physics"></div>
          <div class="explore-dot lit" title="Psychological"></div>
          <div class="explore-dot lit" title="Poetic"></div>
          <div class="explore-dot lit" title="Practice"></div>
          <span class="explore-label">4 layers</span>
        </div>
      </div>
    `;
    glossary.appendChild(card);
  });
}

function toggleCard(card) {
  const isOpen = card.classList.contains('expanded');
  document.querySelectorAll('.term-card.expanded').forEach(c => c.classList.remove('expanded'));
  if (!isOpen) card.classList.add('expanded');
}

function filterCards(tag, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.term-card').forEach(card => {
    const show = tag === 'all' || card.dataset.tag === tag;
    card.style.display = show ? '' : 'none';
    card.classList.remove('expanded');
  });
}

buildCards();
